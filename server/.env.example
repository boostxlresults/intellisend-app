# ============================================
# IntelliSend server environment variables
# Copy to .env and fill in real values.
# ============================================

# --- Core ---
DATABASE_URL=postgresql://user:password@host:5432/intellisend
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production
# Comma-separated list of allowed frontend origins (CORS). Leave unset to allow all.
FRONTEND_URL=https://app.intellisend.net
# Optional cookie domain for shared subdomains.
COOKIE_DOMAIN=

# --- OpenAI (AI SMS agent) ---
OPENAI_API_KEY=sk-...
# Optional model override (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# --- Twilio (global fallback; per-tenant creds live in TenantIntegration) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...

# --- Email (Resend) ---
RESEND_API_KEY=re_...

# --- SpeedToLead360 first-touch webhook ---
# Shared secret STL360 must send in the `X-STL360-Key` header on
# POST /api/webhooks/speed-to-lead/first-touch. If unset, the endpoint
# fails safe and rejects all requests with 503.
STL360_WEBHOOK_KEY=change-me-shared-secret

# --- Replit object storage (Replit-only; unset on Railway) ---
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
